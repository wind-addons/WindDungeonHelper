package-as: WindDungeonHelper

externals:
  Libraries/Ace3:
    url: https://www.wowace.com/projects/ace3/files
    type: svn
  Libraries/LibDBIcon-1.0:
    url: https://www.wowace.com/projects/libdbicon-1-0/files
    type: svn
  Libraries/LibNPCInfo:
    url: https://github.com/wind-addons/LibNPCInfo
    branch: main

ignore:
  - .gitignore
  - .gitmodules
  - .gitattributes
  - .github/*
  - README.md
  - README_zhCN.md
  - README_zhTW.md
  - README_ruRU.md